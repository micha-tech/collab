# ------------------------------------------------------------------
# V One Collab — environment variables
# Copy this file to `.env.local` and fill in the real values.
# Never commit `.env.local`.
# ------------------------------------------------------------------

# LiveKit Cloud (https://cloud.livekit.io)
LIVEKIT_URL=wss://my-project-qez6jft4.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# SERVER ONLY — never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Shared serverless rate limiting (https://console.upstash.com/redis)
# Production should always configure both values. Development falls back to
# an in-process limiter when they are absent.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Public origin of the app (used to build meeting URLs).
# Must use your Vercel domain after deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
